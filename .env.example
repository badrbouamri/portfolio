# Contact form (app/[locale]/contact) — Resend integration.
# Copy this file to .env.local and fill in real values for local development.
# Without RESEND_API_KEY, the contact form degrades gracefully: submissions are
# validated and rate-limited as normal, but sending fails cleanly with a logged
# server-side error and a generic user-facing message instead of crashing.

# Required to actually send contact emails. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# Mailbox that receives contact form submissions.
CONTACT_TO_EMAIL=badrbouamri4@gmail.com
# Verified sender identity. Falls back to Resend's shared testing address
# (onboarding@resend.dev) until a custom domain is verified with Resend.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
